---
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Built with Astro' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{/* Hide [data-reveal] text until the reveal script has prepared it; show it anyway if the script hasn't run within 3s */}
		<script is:inline>
			document.documentElement.setAttribute('data-reveal-pending', '');
			setTimeout(() => {
				if (!('revealReady' in document.documentElement.dataset)) document.documentElement.removeAttribute('data-reveal-pending');
			}, 3000);
		</script>
	</head>
	<body class="flex min-h-dvh flex-col">
		<slot name="header"><Navbar /></slot>
		<main class="relative z-10 flex-1 bg-surface">
			<slot />
		</main>
		<Footer />
		<script>
			import '../scripts/smooth-scroll';
			import '../scripts/reveal';
			import '../scripts/stack';
			import '../scripts/image-reveal';
			import '../scripts/logo-reveal';
		</script>
	</body>
</html>
