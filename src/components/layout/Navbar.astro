---
import Logo from '../../assets/logo.svg';
import MenuIcon from '../../assets/icons/menu.svg';
import CloseIcon from '../../assets/icons/close.svg';
import Container from '../ui/Container.astro';
import NavLink from '../ui/NavLink.astro';
import Button from '../ui/Button.astro';

interface Link {
	href: string;
	label: string;
	hasMenu?: boolean;
}

interface Props {
	links?: Link[];
	cta?: { href: string; label: string };
	/**
	 * Fixed and transparent over the first section of the page (dark theme), then switches to a solid
	 * white bar with dark content once that section scrolls out from under it. Without it the bar is
	 * simply sticky and solid.
	 */
	overlay?: boolean;
	class?: string;
}

const {
	links = [
		{ href: '#', label: 'For individuals', hasMenu: true },
		{ href: '#', label: 'For organizations', hasMenu: true },
		{ href: '#', label: 'Company', hasMenu: true },
	],
	cta = { href: '#', label: 'Get started' },
	overlay = false,
	class: className,
} = Astro.props;
---

{/*
	States: over the hero (overlay, dark theme, transparent) · solid (white bar, dark content) · menu open (below md:
	always solid white, full-screen panel, page scroll locked). `data-solid` / `data-menu-open` are set by the script.
*/}
<header
	class:list={[
		'group/nav top-0 z-50 text-ink transition-colors duration-300 ease-in-out data-solid:bg-surface-white',
		overlay ? 'theme-dark fixed inset-x-0' : 'sticky',
		className,
	]}
	data-navbar
	data-overlay={overlay ? '' : undefined}
	data-solid={overlay ? undefined : ''}
>
	{/* Desktop: the bar grows slightly taller once it's solid (past the hero) */}
	<Container class="flex items-center justify-between gap-6 py-3 transition-[padding] duration-300 ease-in-out lg:group-data-solid/nav:py-4">
		<a href={import.meta.env.BASE_URL} aria-label="Home" class="shrink-0" data-logo-reveal>
			<Logo class="h-5 w-auto" aria-hidden="true" />
		</a>

		<nav aria-label="Main" class="flex items-center gap-6">
			<ul class="hidden items-center gap-6 md:flex">
				{
					links.map((link) => (
						<li>
							<NavLink href={link.href} hasMenu={link.hasMenu}>
								{link.label}
							</NavLink>
						</li>
					))
				}
			</ul>
			<Button href={cta.href} variant="tertiary" size="sm" class="duration-300">{cta.label}</Button>
			<button
				type="button"
				class="-mr-1 cursor-pointer p-1 md:hidden"
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="navbar-mobile-menu"
				data-navbar-toggle
			>
				<MenuIcon class="size-6 group-data-menu-open/nav:hidden" aria-hidden="true" />
				<CloseIcon class="hidden size-6 group-data-menu-open/nav:block" aria-hidden="true" />
			</button>
		</nav>
	</Container>

	{/* Full-screen panel under the bar (viewport height minus the bar); fades in/out */}
	<div
		id="navbar-mobile-menu"
		class="invisible absolute inset-x-0 top-full h-[calc(100dvh-100%)] overflow-y-auto border-t border-border-subtle bg-surface-white opacity-0 transition-[opacity,visibility] duration-300 ease-in-out group-data-menu-open/nav:visible group-data-menu-open/nav:opacity-100 md:hidden"
		data-navbar-menu
	>
		<Container as="nav" class="py-8" aria-label="Mobile">
			<ul class="flex flex-col gap-6">
				{
					links.map((link) => (
						<li>
							<NavLink href={link.href} class="font-display text-h5! font-light">
								{link.label}
							</NavLink>
						</li>
					))
				}
			</ul>
		</Container>
	</div>
</header>

<script>
	import { lenis } from '../../scripts/smooth-scroll';

	const desktop = window.matchMedia('(min-width: 48rem)'); // md — the hamburger only exists below this

	document.querySelectorAll<HTMLElement>('[data-navbar]').forEach((navbar) => {
		const overlay = navbar.hasAttribute('data-overlay');
		const toggle = navbar.querySelector<HTMLButtonElement>('[data-navbar-toggle]');
		const menu = navbar.querySelector<HTMLElement>('[data-navbar-menu]');

		let pastHero = false;
		let menuOpen = false;

		// One place decides the look: solid white whenever not over the hero, or whenever the menu is open
		const render = () => {
			const solid = !overlay || pastHero || menuOpen;
			navbar.toggleAttribute('data-solid', solid);
			navbar.toggleAttribute('data-menu-open', menuOpen);
			if (overlay) navbar.classList.toggle('theme-dark', !solid);
		};

		// Overlay mode: go solid once the first section (the hero) has scrolled out from under the bar
		const hero = document.querySelector('main > :first-child');
		if (overlay && hero) {
			new IntersectionObserver(
				([entry]) => {
					pastHero = !entry.isIntersecting;
					render();
				},
				// Shrink the viewport's top edge by the bar's height so the switch happens as the hero's bottom passes under it
				{ rootMargin: `-${navbar.offsetHeight}px 0px 0px 0px` },
			).observe(hero);
		}

		if (!toggle || !menu) return;

		const setMenu = (open: boolean) => {
			if (open === menuOpen) return;
			menuOpen = open;
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			// Lock the page behind the full-screen menu
			document.documentElement.style.overflow = open ? 'hidden' : '';
			if (open) lenis?.stop();
			else lenis?.start();
			render();
		};

		toggle.addEventListener('click', () => setMenu(!menuOpen));
		menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menuOpen) {
				setMenu(false);
				toggle.focus();
			}
		});
		// The menu doesn't exist at md+, so close it if the window grows past the breakpoint
		desktop.addEventListener('change', (event) => event.matches && setMenu(false));
	});
</script>
