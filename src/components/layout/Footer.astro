---
import type { HTMLAttributes } from 'astro/types';
import Logo from '../../assets/logo.svg';
import Facebook from '../../assets/icons/facebook.svg';
import Instagram from '../../assets/icons/instagram.svg';
import X from '../../assets/icons/x.svg';
import LinkedIn from '../../assets/icons/linkedin.svg';
import Container from '../ui/Container.astro';
import FooterColumn from '../patterns/FooterColumn.astro';
import type { Link } from '../../lib/types';

// The platforms an editor can pick in Site Settings, with their icon and accessible name
const platforms = {
	facebook: { label: 'Facebook', icon: Facebook },
	instagram: { label: 'Instagram', icon: Instagram },
	x: { label: 'X', icon: X },
	linkedin: { label: 'LinkedIn', icon: LinkedIn },
};

// Content comes from Site Settings in Sanity (fetched in BaseLayout)
interface Props extends HTMLAttributes<'footer'> {
	columns: { title: string; links: Link[] }[];
	legalLinks: Link[];
	socials: { platform: keyof typeof platforms; href: string }[];
	/** "{year}" is replaced with the current year */
	copyright: string;
}

const { columns, legalLinks, socials, copyright, class: className, ...attrs } = Astro.props;
---

{/*
	Desktop reveal (global.css, "Footer reveal"): as the footer scrolls in, its content moves at half speed inside
	the clipped box, starting shifted up by half its height — so it emerges from its middle as the page slides away.
*/}
<footer class:list={['theme-dark bg-surface text-ink', className]} data-footer-reveal {...attrs}>
	<Container class="flex flex-col gap-14 py-20 lg:flex-row lg:justify-between" data-footer-reveal-content>
		<a href={import.meta.env.BASE_URL} aria-label="Home" class="shrink-0 self-start" data-logo-reveal>
			<Logo class="h-5 w-auto" aria-hidden="true" />
		</a>

		<div class="flex flex-col gap-20 lg:w-229.5 lg:gap-30">
			<nav aria-label="Footer" class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-5">
				{columns.map((column) => <FooterColumn {...column} />)}
			</nav>

			<div class="flex flex-col gap-10">
				<ul class="flex max-w-169.75 flex-wrap gap-4 text-body-xs opacity-60">
					{
						legalLinks.map((link) => (
							<li>
								<a href={link.href} class="hover:underline">
									{link.label}
								</a>
							</li>
						))
					}
				</ul>

				<hr class="border-border-strong/10" />

				<div class="flex flex-col gap-6">
					<ul class="flex items-center gap-6">
						{
							socials.map(({ platform, href }) => {
								const { label, icon: Icon } = platforms[platform];
								return (
									<li>
										<a href={href} aria-label={label} class="block opacity-60 transition-opacity hover:opacity-100">
											<Icon class="size-5" aria-hidden="true" />
										</a>
									</li>
								);
							})
						}
					</ul>
					<p class="text-body-xs text-ink-muted">{copyright.replaceAll('{year}', String(new Date().getFullYear()))}</p>
				</div>
			</div>
		</div>
	</Container>
</footer>
