---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	href: string;
	/** ISO date, e.g. "2025-08-21" — displayed as "Aug 21, 2025" */
	date: string;
	image: ImageMetadata;
	imageAlt: string;
	class?: string;
}

const { title, href, date, image, imageAlt, class: className } = Astro.props;

const formatted = new Date(`${date}T00:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<!-- Whole card is clickable via the title link's overlay -->
<article class:list={['group relative flex gap-4 text-ink sm:gap-6', className]}>
	<div class="relative aspect-3/2 w-30 shrink-0 overflow-hidden sm:w-60">
		<Image src={image} alt={imageAlt} widths={[240, 480]} sizes="(min-width: 640px) 240px, 120px" class="absolute inset-0 size-full object-cover" />
	</div>
	<div class="flex flex-1 flex-col gap-2 text-body-sm sm:gap-4 sm:text-body">
		<h3 class="max-w-83.5 font-sans font-normal">
			<a href={href} class="after:absolute after:inset-0 group-hover:underline focus-visible:outline-none">{title}</a>
		</h3>
		<time datetime={date}>{formatted}</time>
	</div>
	<!-- Focus ring for the whole card when the link is keyboard-focused -->
	<span class="pointer-events-none absolute -inset-1 hidden outline-2 outline-current group-has-[a:focus-visible]:block" aria-hidden="true"></span>
</article>
