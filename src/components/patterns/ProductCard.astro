---
import type { HTMLAttributes } from 'astro/types';
import SanityImage from '../ui/SanityImage.astro';
import type { SanityImageSource } from '../../sanity/image';
import Registered from '../../assets/icons/registered.svg';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import ButtonGroup from './ButtonGroup.astro';
import type { Link } from '../../lib/types';

interface Props extends HTMLAttributes<'article'> {
	name: string;
	/** Includes its alt text and hotspot */
	image: SanityImageSource;
	badges?: { label: string; variant?: 'neutral' | 'success' }[];
	/** Shows the ® mark after the name */
	registered?: boolean;
	disclosure?: Link;
	primaryCta?: Link;
	secondaryCta?: Link;
}

const { name, image, badges = [], registered = false, disclosure, primaryCta, secondaryCta, class: className, ...attrs } = Astro.props;
---

<article class:list={['relative flex flex-col-reverse overflow-hidden bg-surface-white text-ink sm:flex-row', className]} data-product-card {...attrs}>
	<div class="flex flex-1 flex-col justify-between gap-6 p-4">
		<div class="flex flex-col gap-6">
			{
				badges.length > 0 && (
					<div class="flex flex-wrap items-center gap-1.5">
						{badges.map((badge) => (
							<Badge variant={badge.variant ?? 'neutral'}>{badge.label}</Badge>
						))}
					</div>
				)
			}
			<div class="flex flex-col gap-4">
				<h3 class="flex items-start text-h4">
					{name}
					{
						registered && (
							<>
								<Registered class="size-3 shrink-0" aria-hidden="true" />
								<span class="sr-only">®</span>
							</>
						)
					}
				</h3>
				{
					disclosure && (
						<a href={disclosure.href} class="text-body-xs text-ink-muted hover:underline">
							{disclosure.label}
						</a>
					)
				}
			</div>
		</div>

		{
			(primaryCta || secondaryCta) && (
				<ButtonGroup>
					{primaryCta && (
						<Button href={primaryCta.href} variant="secondary" size="sm">
							{primaryCta.label}
						</Button>
					)}
					{secondaryCta && (
						<Button href={secondaryCta.href} variant="tertiary" size="sm">
							{secondaryCta.label}
						</Button>
					)}
				</ButtonGroup>
			)
		}
	</div>

	<div class="relative h-56 shrink-0 overflow-hidden sm:h-76.5 sm:w-76">
		{/* Image framing from Figma: oversized, anchored low and slightly right so it bleeds off the card */}
		<div class="absolute top-[8.5%] bottom-[-25.16%] left-[54.3%] aspect-[1200/1040] -translate-x-1/2">
			<SanityImage
				image={image}
				widths={[420, 840, 1200]}
				sizes="420px"
				quality={90}
				class="absolute inset-0 size-full max-w-none object-cover"
				data-product-card-image
			/>
		</div>
	</div>
</article>

<script>
	import { gsap } from 'gsap';
	import { canHover, reducedMotion } from '../../scripts/motion';

	// Subtle zoom on hover — pointer devices only, skipped when the user prefers reduced motion
	if (canHover && !reducedMotion) {
		document.querySelectorAll<HTMLElement>('[data-product-card]').forEach((card) => {
			const image = card.querySelector('[data-product-card-image]');
			if (!image) return;

			const zoom = (scale: number) => gsap.to(image, { scale, duration: 0.4, ease: 'power2.inOut', overwrite: 'auto' });

			card.addEventListener('mouseenter', () => zoom(1.08));
			card.addEventListener('mouseleave', () => zoom(1));
		});
	}
</script>
