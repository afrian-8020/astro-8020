---
import type { HTMLAttributes } from 'astro/types';
import ChevronDown from '../../assets/icons/chevron-down-lg.svg';

interface Props extends HTMLAttributes<'details'> {
	question: string;
	/** One string per paragraph */
	answer: string[];
	open?: boolean;
	/** Items sharing a group name behave as an exclusive accordion (native <details name>; animated when JS runs) */
	group?: string;
}

const { question, answer, open = false, group, class: className, ...attrs } = Astro.props;
---

<details
	class:list={[
		'group border-t border-surface-inverse/10 text-ink transition-colors duration-500 data-expanded:border-surface-inverse [&::-webkit-details-marker]:hidden',
		className,
	]}
	name={group}
	open={open}
	data-faq
	data-faq-group={group}
	data-expanded={open ? '' : undefined}
	{...attrs}
>
	<summary
		class="flex cursor-pointer list-none items-center justify-between gap-10 pt-4 text-body focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current [&::-webkit-details-marker]:hidden"
	>
		<span>{question}</span>
		<ChevronDown class:list={['size-6 shrink-0', open && 'rotate-180']} aria-hidden="true" data-faq-chevron />
	</summary>
	<div class="overflow-hidden" data-faq-panel>
		<div class="flex flex-col gap-6 pt-6 pb-4 text-body text-balance">
			{answer.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</div>
</details>

<script>
	import { gsap } from 'gsap';
	import { ACCORDION, collapsePanel, expandPanel } from '../../scripts/accordion';

	const items = [...document.querySelectorAll<HTMLDetailsElement>('[data-faq]')];

	const parts = (item: HTMLDetailsElement) => ({
		panel: item.querySelector<HTMLElement>('[data-faq-panel]')!,
		chevron: item.querySelector<SVGElement>('[data-faq-chevron]')!,
	});

	const expand = (item: HTMLDetailsElement) => {
		const { panel, chevron } = parts(item);
		item.open = true;
		item.setAttribute('data-expanded', '');
		expandPanel(panel);
		gsap.to(chevron, { rotation: 180, ...ACCORDION, overwrite: true });
	};

	const collapse = (item: HTMLDetailsElement) => {
		const { panel, chevron } = parts(item);
		item.removeAttribute('data-expanded');
		collapsePanel(panel, () => (item.open = false));
		gsap.to(chevron, { rotation: 0, ...ACCORDION, overwrite: true });
	};

	items.forEach((item) => {
		// The script enforces "one open per group" itself; the native `name` behaviour would close items instantly
		item.removeAttribute('name');
		// Hand the chevron's resting rotation over to GSAP
		gsap.set(parts(item).chevron, { rotation: item.open ? 180 : 0 });
		parts(item).chevron.classList.remove('rotate-180');

		item.querySelector('summary')!.addEventListener('click', (event) => {
			event.preventDefault();
			if (item.hasAttribute('data-expanded')) return collapse(item);

			const group = item.dataset.faqGroup;
			if (group) items.filter((other) => other !== item && other.dataset.faqGroup === group && other.hasAttribute('data-expanded')).forEach(collapse);
			expand(item);
		});
	});
</script>
