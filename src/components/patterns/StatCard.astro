---
import type { HTMLAttributes } from 'astro/types';
import { revealAttrs, type Reveal } from '../../lib/reveal';

interface Props extends HTMLAttributes<'figure'> {
	/** The stat in words — also serves as the accessible description of the visual */
	caption: string;
	/** Max width for the caption so it wraps like the design (a Tailwind max-w-* class) */
	captionClass?: string;
	/** Fade the caption in with its section's text (src/lib/reveal.ts) */
	reveal?: Reveal;
}

const { caption, captionClass = 'max-w-72', reveal, class: className, ...attrs } = Astro.props;

// Keep hyphenated terms (e.g. "GLP-1s", "weight-loss") on one line, as in the design
const words = caption.split(' ');
---

{/* Inside a `group/stats` grid, the other cards fade to 20% while one is hovered */}
<figure
	class:list={[
		'flex flex-col items-center gap-6 overflow-hidden bg-surface-white pb-6 text-ink transition-opacity duration-500 ease-in-out [@media(hover:hover)]:group-has-[figure:hover]/stats:[&:not(:hover)]:opacity-20',
		className,
	]}
	{...attrs}
>
	{/* Visual keeps the 448×320 design ratio and never grows past it */}
	<div class="aspect-448/320 w-full max-w-112">
		<slot />
	</div>
	<figcaption class:list={['text-center text-body', captionClass]} {...revealAttrs(reveal)}>
		{words.map((word, i) => (
			<>
				{word.includes('-') ? <span class="whitespace-nowrap">{word}</span> : word}
				{i < words.length - 1 && ' '}
			</>
		))}
	</figcaption>
</figure>
