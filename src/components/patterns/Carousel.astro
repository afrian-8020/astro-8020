---
import ChevronLeft from '../../assets/icons/chevron-left.svg';
import IconButton from '../ui/IconButton.astro';

interface Props {
	/** Accessible name for the carousel region */
	label: string;
	class?: string;
}

const { label, class: className } = Astro.props;
---

{/*
	Horizontal scroll-snap carousel. Pass items with <CarouselItem>.
	The track bleeds to the viewport edges at any width; --bleed = gutter, or the space beside max-w-content on wide screens,
	so items still snap to the container edge.
	Wrap in an element with overflow-x-clip to absorb scrollbar-width rounding on Windows.
	Optional `aside` slot renders at the end of the controls row (e.g. a "view all" link).
*/}
<div class:list={['flex flex-col gap-10', className]} role="region" aria-roledescription="carousel" aria-label={label} data-carousel>
	<ul
		class="scrollbar-none relative flex snap-x snap-mandatory gap-4 overflow-x-auto [--bleed:max(--spacing(4),calc((100vw-var(--container-content))/2))] sm:[--bleed:max(--spacing(6),calc((100vw-var(--container-content))/2))] -mx-(--bleed) px-(--bleed) scroll-px-(--bleed)"
		data-carousel-track
	>
		<slot />
	</ul>

	<div class="flex items-center justify-between gap-6">
		<div class="flex items-center gap-2">
			<IconButton label="Previous" data-carousel-prev>
				<ChevronLeft class="size-4" aria-hidden="true" />
			</IconButton>
			<IconButton label="Next" data-carousel-next>
				<ChevronLeft class="size-4 -scale-x-100" aria-hidden="true" />
			</IconButton>
		</div>
		<slot name="aside" />
	</div>
</div>

<script>
	import { gsap } from 'gsap';
	import { ScrollToPlugin } from 'gsap/ScrollToPlugin';

	gsap.registerPlugin(ScrollToPlugin);

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
		const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
		const prev = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
		const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
		if (!track || !prev || !next) return;

		const items = [...track.children] as HTMLElement[];
		let tween: gsap.core.Tween | null = null;
		let target = 0;

		const maxScroll = () => track.scrollWidth - track.clientWidth;

		// Reachable snap positions: each item aligned to the container edge, capped at the end of the track
		const points = () => {
			const pad = parseFloat(getComputedStyle(track).paddingLeft);
			return [...new Set(items.map((item) => Math.round(Math.min(item.offsetLeft - pad, maxScroll()))))];
		};

		const nearest = (list: number[], x: number) => list.reduce((best, p, i) => (Math.abs(p - x) < Math.abs(list[best] - x) ? i : best), 0);

		const update = () => {
			prev.disabled = track.scrollLeft <= 1;
			next.disabled = track.scrollLeft >= maxScroll() - 1;
		};

		const go = (direction: 1 | -1) => {
			const list = points();
			// Chain from the pending target on rapid clicks, otherwise from where the track is (it may have been swiped)
			const from = nearest(list, tween?.isActive() ? target : track.scrollLeft);
			target = list[Math.max(0, Math.min(list.length - 1, from + direction))];

			tween?.kill();
			// Snap fights programmatic scrolling mid-tween; pause it and restore when done
			track.style.scrollSnapType = 'none';
			const restoreSnap = () => (track.style.scrollSnapType = '');
			tween = gsap.to(track, {
				scrollTo: { x: target, autoKill: true },
				duration: reduceMotion.matches ? 0 : 0.65,
				ease: 'power2.inOut',
				onComplete: restoreSnap,
				onInterrupt: restoreSnap,
			});
		};

		prev.addEventListener('click', () => go(-1));
		next.addEventListener('click', () => go(1));
		track.addEventListener('scroll', update, { passive: true });
		window.addEventListener('resize', update);
		update();
	});
</script>
