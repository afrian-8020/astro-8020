---
interface Props {
	title: string;
	description: string;
	class?: string;
}

const { title, description, class: className } = Astro.props;
---

<div class:list={['flex flex-col gap-2 text-ink', className]}>
	<h2 class="font-sans font-normal text-body" data-reveal data-reveal-group="features">{title}</h2>
	<p class="text-body-sm" data-reveal data-reveal-group="features">{description}</p>
</div>
