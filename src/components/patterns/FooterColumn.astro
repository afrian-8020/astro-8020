---
interface Props {
	title: string;
	links: { href: string; label: string }[];
	class?: string;
}

const { title, links, class: className } = Astro.props;
---

<div class:list={['flex flex-col gap-6 text-ink', className]}>
	<h2 class="font-sans text-eyebrow font-normal uppercase">{title}</h2>
	<ul class="flex flex-col gap-2 text-body-sm">
		{
			links.map((link) => (
				<li>
					<a href={link.href} class="hover:underline">
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
</div>
