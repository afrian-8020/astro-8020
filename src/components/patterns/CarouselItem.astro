---
import type { HTMLAttributes } from 'astro/types';
import { revealAttrs, type Reveal } from '../../lib/reveal';

interface Props extends HTMLAttributes<'li'> {
	/** Fade the whole item in with its section's text (desktop only; src/lib/reveal.ts) */
	reveal?: Reveal;
}

const { reveal, class: className, ...attrs } = Astro.props;
---

<li class:list={['shrink-0 snap-start', className]} {...revealAttrs(reveal, 'card')} {...attrs}>
	<slot />
</li>
