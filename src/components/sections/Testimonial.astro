---
import type { ComponentProps, HTMLAttributes } from 'astro/types';
import SanityImage from '../ui/SanityImage.astro';
import type { SanityImageSource } from '../../sanity/image';
import Container from '../ui/Container.astro';
import TestimonialCard from '../patterns/TestimonialCard.astro';

interface Props extends HTMLAttributes<'section'> {
	background: SanityImageSource;
	testimonial: Omit<ComponentProps<typeof TestimonialCard>, 'class' | 'reveal'>;
}

const { background, testimonial, class: className, ...attrs } = Astro.props;
---

{/* A single testimonial card over a fixed full-bleed photo */}
{/* Animation: the card's portrait reveal, text fade-in and count-up (see TestimonialCard's `reveal`) */}
<section class:list={['relative isolate overflow-hidden bg-surface-muted py-20 lg:py-50', className]} {...attrs}>
	{/*
		Fixed backdrop (desktop): the photo is pinned to the viewport and the section scrolls over it like a window.
		Below lg it's a regular cover image.
		clip-path (unlike overflow) also clips fixed-position children, so it only shows through this section.
		The mirror + 1.25 zoom (anchored bottom) lives on the image itself — a transform on the wrapper would break `fixed`.
	*/}
	<div class="absolute inset-0 -z-10 [clip-path:inset(0)]" aria-hidden="true">
		<SanityImage
			image={background}
			alt=""
			widths={[768, 1024, 1456]}
			sizes="125vw"
			quality={90}
			class="absolute inset-0 size-full max-w-none origin-bottom scale-[-1.25_1.25] object-cover object-right lg:fixed"
		/>
	</div>

	<Container>
		<div class="mx-auto max-w-289">
			<TestimonialCard {...testimonial} reveal />
		</div>
	</Container>
</section>
