---
import type { ComponentProps, HTMLAttributes } from 'astro/types';
import Container from '../ui/Container.astro';
import FaqItem from '../patterns/FaqItem.astro';
import SectionHeader from '../patterns/SectionHeader.astro';

interface Props extends Omit<HTMLAttributes<'section'>, 'title'> {
	title: string;
	items: Omit<ComponentProps<typeof FaqItem>, 'group'>[];
	/** Legal footnotes under the list; use "\n" inside a string for a line break without a gap */
	footnotes?: string[];
}

const { title, items, footnotes = [], class: className, ...attrs } = Astro.props;
---

{/* Fade-in: the title only */}
<section class:list={['bg-surface py-20 text-ink lg:py-30', className]} {...attrs}>
	<Container>
		<div class="mx-auto flex max-w-230 flex-col gap-14 lg:gap-20">
			<SectionHeader title={title} align="center" reveal />

			<div class="flex flex-col gap-4">
				{items.map((item) => <FaqItem {...item} group="faq" />)}
			</div>

			{
				footnotes.length > 0 && (
					<div class="flex flex-col gap-4.5 text-body-xs whitespace-pre-line text-ink-muted">
						{footnotes.map((note) => <p>{note}</p>)}
					</div>
				)
			}
		</div>
	</Container>
</section>
