---
import type { ComponentProps, HTMLAttributes } from 'astro/types';
import Container from '../ui/Container.astro';
import ArticleCard from '../patterns/ArticleCard.astro';
import SectionHeader from '../patterns/SectionHeader.astro';
import type { Link } from '../../lib/types';

interface Props extends Omit<HTMLAttributes<'section'>, 'title'> {
	title: string;
	description?: string;
	moreLink?: Link;
	articles: Omit<ComponentProps<typeof ArticleCard>, 'class'>[];
}

const { title, description, moreLink, articles, class: className, ...attrs } = Astro.props;
---

{/* Fade-in order: title → description → "more" link */}
<section class:list={['bg-surface py-20 text-ink lg:py-30', className]} {...attrs}>
	<Container class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
		<SectionHeader title={title} description={description} class="max-w-111.75" reveal>
			{
				moreLink && (
					<a href={moreLink.href} class="-my-2 self-start py-2 text-body hover:underline" data-reveal>
						{moreLink.label}
					</a>
				)
			}
		</SectionHeader>

		<ul class="flex flex-col gap-4 lg:w-171">
			{
				articles.map((article, i) => (
					<li class:list={[i > 0 && 'border-t border-surface-inverse/10 pt-4']}>
						<ArticleCard {...article} />
					</li>
				))
			}
		</ul>
	</Container>
</section>
