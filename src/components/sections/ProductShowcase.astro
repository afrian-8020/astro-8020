---
import type { ComponentProps, HTMLAttributes } from 'astro/types';
import Container from '../ui/Container.astro';
import Carousel from '../patterns/Carousel.astro';
import CarouselItem from '../patterns/CarouselItem.astro';
import ProductCard from '../patterns/ProductCard.astro';
import SectionHeader from '../patterns/SectionHeader.astro';
import type { Link } from '../../lib/types';

interface Props extends Omit<HTMLAttributes<'section'>, 'title'> {
	title: string;
	description?: string;
	products: ComponentProps<typeof ProductCard>[];
	browseLink?: Link;
}

const { title, description, products, browseLink, class: className, ...attrs } = Astro.props;
---

{/* Fade-in order: title → description → product cards one by one (cards on desktop only) */}
<section class:list={['overflow-x-clip bg-surface py-20 text-ink lg:py-30', className]} {...attrs}>
	<Container class="flex flex-col gap-10">
		<SectionHeader title={title} description={description} align="center" class="mx-auto max-w-169" descriptionClass="max-w-112" reveal />

		<Carousel label={title}>
			{
				products.map((product, i) => (
					// First card starts just before the subheading finishes (its fade eases in gently); the rest follow 0.2s apart
					<CarouselItem class="w-4/5 sm:w-141.5" reveal={{ delay: i === 0 ? 0.15 : 0.2 }}>
						<ProductCard {...product} class="h-full" />
					</CarouselItem>
				))
			}
			{
				browseLink && (
					<a slot="aside" href={browseLink.href} class="-my-2 py-2 text-body hover:underline">
						{browseLink.label}
					</a>
				)
			}
		</Carousel>
	</Container>
</section>
