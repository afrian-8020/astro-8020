---
import type { ComponentProps, HTMLAttributes } from 'astro/types';
import Container from '../ui/Container.astro';
import ComparisonTable from '../patterns/ComparisonTable.astro';
import InlineCta from '../patterns/InlineCta.astro';
import SectionHeader from '../patterns/SectionHeader.astro';

type TableProps = ComponentProps<typeof ComparisonTable>;

interface Props extends Omit<HTMLAttributes<'section'>, 'title'> {
	title: string;
	description?: string;
	columns: TableProps['columns'];
	rows: TableProps['rows'];
	cta?: Omit<ComponentProps<typeof InlineCta>, 'reveal'>;
}

const { title, description, columns, rows, cta, class: className, ...attrs } = Astro.props;
---

{/* Fade-in order: title → description → table rows in quick succession → closing line and button */}
<section class:list={['bg-surface pt-10 pb-20 text-ink lg:pb-30', className]} {...attrs}>
	<Container class="flex flex-col gap-14">
		<SectionHeader title={title} description={description} class="max-w-169" descriptionClass="max-w-138.75" reveal />

		<ComparisonTable caption={title} columns={columns} rows={rows} reveal={{ delay: 0.08 }} />

		{cta && <InlineCta {...cta} reveal />}
	</Container>
</section>
