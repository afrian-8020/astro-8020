---
interface Props {
	/** Figure shown in the marker pill, e.g. "97%" */
	value: string;
}

const { value } = Astro.props;
---

<!--
	Decorative: the stat is repeated in the card caption. Illustrative proportions from the design, not data-driven.
	Animates once on arrival and replays on card hover (script below): the bar fills while the pill rides its edge, counting up.
-->
<svg viewBox="0 0 448 320" class="block size-full" aria-hidden="true" data-bar>
	<rect x="52" y="120" width="344" height="81" rx="40.5" class="fill-surface-muted" data-bar-track></rect>
	<rect x="80" y="148" width="288" height="24" rx="12" class="fill-secondary" opacity="0.2" data-bar-remaining></rect>
	<rect x="80" y="148" width="258" height="24" rx="12" class="fill-secondary" data-bar-fill></rect>
	<!-- Marker pill with a 4px ring in the track color -->
	<g data-bar-pill>
		<rect x="263" y="138" width="84" height="44" rx="22" stroke-width="4" class="fill-primary stroke-surface-muted"></rect>
		<text x="305" y="160" text-anchor="middle" dominant-baseline="central" class="fill-ink-inverse font-display text-h5 font-light" data-bar-value
			>{value}</text
		>
	</g>
</svg>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { replayOnHover } from '../../../scripts/chart-hover';

	gsap.registerPlugin(ScrollTrigger);

	// Design geometry: the fill runs 80 → 338; the pill's centre sits 33 units behind the fill's leading edge
	const FILL_X = 80;
	const FILL_WIDTH = 258;
	const PILL_CENTER = 305;
	const PILL_LEAD = 33;
	const PILL_MIN_CENTER = 122; // keeps the pill inside the track while the fill is still short

	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		document.querySelectorAll<SVGSVGElement>('[data-bar]').forEach((svg) => {
			const q = (name: string) => svg.querySelector<SVGElement>(`[data-bar-${name}]`)!;
			const track = q('track');
			const remaining = q('remaining');
			const fill = q('fill');
			const pill = q('pill');
			const valueText = q('value');

			// "97%" → count 0 → 97, keeping any prefix/suffix
			const [, prefix = '', target = '0', suffix = ''] = valueText.textContent!.match(/^(\D*?)(\d+)(.*)$/) ?? [];
			const progress = { p: 0 };

			// Fill width, pill position and figure all derive from one progress value, so they stay locked together
			const render = () => {
				const width = FILL_WIDTH * progress.p;
				gsap.set(fill, { attr: { width: Math.max(width, 24) }, opacity: width > 0 ? 1 : 0 });
				gsap.set(pill, { x: Math.max(FILL_X + width - PILL_LEAD, PILL_MIN_CENTER) - PILL_CENTER });
				valueText.textContent = `${prefix}${Math.round(Number(target) * progress.p)}${suffix}`;
			};

			gsap.set(track, { scaleX: 0.85, opacity: 0, svgOrigin: '224 160' });
			gsap.set(remaining, { opacity: 0 });
			gsap.set(pill, { scale: 0.6, opacity: 0, svgOrigin: `${PILL_CENTER} 160` });
			render();

			const tl = gsap
				.timeline({ paused: true })
				.to(track, { scaleX: 1, opacity: 1, duration: 0.6, ease: 'power2.out' }, 0)
				.to(remaining, { opacity: 0.2, duration: 0.5, ease: 'power2.out' }, 0.2)
				.to(pill, { scale: 1, opacity: 1, duration: 0.4, ease: 'back.out(2)' }, 0.25)
				// Fill, ride and count in one move
				.to(progress, { p: 1, duration: 1.1, ease: 'power2.inOut', onUpdate: render }, 0.3)
				// Settle with a small pop once it lands on the value
				.to(pill, { scale: 1.08, duration: 0.15, ease: 'power2.out' }, 1.4)
				.to(pill, { scale: 1, duration: 0.25, ease: 'power2.inOut' }, 1.55);

			ScrollTrigger.create({ trigger: svg, start: '20% bottom', once: true, onEnter: () => tl.play() });
			replayOnHover(svg, tl, render);
		});
	}
</script>
