---
import ChevronDown from '../../assets/icons/chevron-down.svg';

interface Props {
	href: string;
	/** Shows a chevron to signal the item opens a submenu */
	hasMenu?: boolean;
	current?: boolean;
	class?: string;
}

const { href, hasMenu = false, current = false, class: className } = Astro.props;
---

<a
	href={href}
	aria-current={current ? 'page' : undefined}
	class:list={['inline-flex items-center gap-1 text-body-sm text-ink transition-[color,opacity] duration-300 hover:opacity-80', className]}
>
	<slot />
	{hasMenu && <ChevronDown class="size-3" aria-hidden="true" />}
</a>
