---
import CheckCircle from '../../assets/icons/check-circle.svg';
import XCircle from '../../assets/icons/x-circle.svg';

interface Props {
	/** true renders a filled check, false a muted cross */
	included: boolean;
	/** Screen-reader text for each state */
	labels?: { included: string; excluded: string };
	class?: string;
}

const { included, labels = { included: 'Included', excluded: 'Not included' }, class: className } = Astro.props;
---

<span class:list={['relative inline-flex align-middle text-ink', className]}>
	{included ? <CheckCircle class="size-6" aria-hidden="true" /> : <XCircle class="size-6 opacity-40" aria-hidden="true" />}
	<span class="sr-only">{included ? labels.included : labels.excluded}</span>
</span>
