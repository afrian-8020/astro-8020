---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
	/** outline: bordered label with optional icon · neutral / success: filled uppercase tag */
	variant?: 'outline' | 'neutral' | 'success';
}

const { variant = 'outline', class: className, ...attrs } = Astro.props;

const variants = {
	outline: 'gap-2 rounded-md border border-border-strong px-2 py-0.75 text-body-xs text-ink',
	neutral: 'rounded-sm bg-badge-bg px-1.5 py-0.5 text-eyebrow uppercase text-badge-text',
	success: 'rounded-sm bg-badge-success-bg px-1.5 py-0.5 text-eyebrow uppercase text-badge-success-text',
};
---

<span class:list={['inline-flex items-center whitespace-nowrap', variants[variant], className]} {...attrs}>
	<slot name="icon" />
	<slot />
</span>
