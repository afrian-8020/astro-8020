---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import ProductShowcase from '../components/sections/ProductShowcase.astro';
import Comparison from '../components/sections/Comparison.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Science from '../components/sections/Science.astro';
import StatCard from '../components/patterns/StatCard.astro';
import DonutChart from '../components/ui/charts/DonutChart.astro';
import CurveChart from '../components/ui/charts/CurveChart.astro';
import BarChart from '../components/ui/charts/BarChart.astro';
import Testimonial from '../components/sections/Testimonial.astro';
import Articles from '../components/sections/Articles.astro';
import Cta from '../components/sections/Cta.astro';
import Faq from '../components/sections/Faq.astro';
import { sanityClient } from '../sanity/client';
import { HOME_PAGE_QUERY } from '../sanity/queries';

// All page content comes from the Home Page document in Sanity (Studio: ../studio-afrian---astro-8020)
const page = await sanityClient.fetch(HOME_PAGE_QUERY);

/** Fail the build loudly, naming the field, rather than rendering a half-empty page */
function need<T>(value: T | null | undefined, field: string): T {
	if (value === null || value === undefined) throw new Error(`Sanity: Home Page is missing "${field}"`);
	return value;
}
const link = (value: { label: string | null; href: string | null } | null | undefined) =>
	value?.label && value.href ? { label: value.label, href: value.href } : undefined;

const home = need(page, 'the published homePage document');
const hero = need(home.hero, 'hero');
const showcase = need(home.productShowcase, 'productShowcase');
const comparison = need(home.comparison, 'comparison');
const howItWorks = need(home.howItWorks, 'howItWorks');
const science = need(home.science, 'science');
const testimonial = need(home.testimonialSection?.testimonial, 'testimonialSection.testimonial');
const articles = need(home.articlesSection, 'articlesSection');
const callToAction = need(home.callToAction, 'callToAction');
const faq = need(home.faq, 'faq');

// The carousel shows the products twice (1, 2, 3, 1, 2, 3)
const products = (showcase.products ?? []).map((product) => ({
	name: need(product.name, 'product name'),
	registered: product.registered ?? false,
	badges: (product.tags ?? []).map((tag) => ({
		label: need(tag.label, 'product tag'),
		variant: tag.kind === 'benefit' ? ('success' as const) : ('neutral' as const),
	})),
	image: need(product.image, `${product.name} image`),
	disclosure: link(product.disclosure),
	primaryCta: link(product.primaryCta),
	secondaryCta: link(product.secondaryCta),
}));

// Caption widths that wrap like the design, per chart kind
const statCaptionClass = { ring: 'max-w-69.25', curves: 'max-w-63', scale: 'max-w-84.75' } as const;
---

<BaseLayout title={home.seo?.title ?? 'Noom Med'} description={home.seo?.description ?? undefined}>
	<Navbar slot="header" overlay />

	<Hero
		badge={hero.badge ?? undefined}
		title={need(hero.heading, 'hero.heading')}
		description={need(hero.description, 'hero.description')}
		cta={link(hero.cta)}
		image={need(hero.image, 'hero.image')}
		features={(hero.benefits ?? []).map((benefit) => ({
			title: need(benefit.title, 'hero benefit title'),
			description: need(benefit.description, 'hero benefit description'),
		}))}
	/>

	<ProductShowcase
		title={need(showcase.heading, 'productShowcase.heading')}
		description={showcase.description ?? undefined}
		browseLink={link(showcase.browseLink)}
		products={[...products, ...products]}
	/>
	<Comparison
		title={need(comparison.heading, 'comparison.heading')}
		description={comparison.description ?? undefined}
		columns={[{ label: 'Noom Med', brand: { sublabel: 'MED' } }, { label: need(comparison.alternativeLabel, 'comparison.alternativeLabel') }]}
		rows={(comparison.features ?? []).map((row) => ({
			label: need(row.feature, 'comparison feature'),
			values: [row.includedWithNoom ?? false, row.includedWithAlternative ?? false],
		}))}
		cta={comparison.ctaText && link(comparison.cta) ? { text: comparison.ctaText, cta: link(comparison.cta)! } : undefined}
	/>
	<HowItWorks
		eyebrow={howItWorks.eyebrow ?? undefined}
		title={need(howItWorks.heading, 'howItWorks.heading')}
		steps={(howItWorks.steps ?? []).map((step) => ({
			title: need(step.title, 'step title'),
			description: step.description ?? undefined,
			image: need(step.image, `"${step.title}" image`),
		}))}
	/>
	<Science title={need(science.heading, 'science.heading')} description={science.description ?? undefined}>
		{
			(science.stats ?? []).map((stat) => (
				<StatCard caption={need(stat.caption, 'stat caption')} captionClass={stat.chart ? statCaptionClass[stat.chart] : undefined}>
					{stat.chart === 'ring' && <DonutChart value={stat.figure ?? ''} label={stat.figureLabel ?? undefined} />}
					{stat.chart === 'curves' && <CurveChart topLabel={stat.baselineLabel ?? ''} bottomLabel={stat.highlightLabel ?? ''} />}
					{stat.chart === 'scale' && <BarChart value={stat.figure ?? ''} />}
				</StatCard>
			))
		}
	</Science>
	<Testimonial
		background={need(home.testimonialSection?.background, 'testimonialSection.background')}
		testimonial={{
			quote: need(testimonial.quote, 'testimonial quote'),
			author: need(testimonial.author, 'testimonial author'),
			image: need(testimonial.portrait, 'testimonial portrait'),
			stat:
				testimonial.result?.value && testimonial.result.label
					? { value: testimonial.result.value, label: testimonial.result.label, countFrom: testimonial.result.countFrom ?? undefined }
					: undefined,
		}}
	/>

	<Articles
		title={need(articles.heading, 'articlesSection.heading')}
		description={articles.description ?? undefined}
		moreLink={link(articles.moreLink)}
		articles={(articles.articles ?? []).map((article) => ({
			title: need(article.title, 'article title'),
			href: need(article.url, `"${article.title}" URL`),
			date: need(article.publishedAt, `"${article.title}" date`),
			image: need(article.image, `"${article.title}" image`),
		}))}
	/>

	<Cta
		title={need(callToAction.heading, 'callToAction.heading')}
		description={callToAction.description ?? undefined}
		cta={need(link(callToAction.cta), 'callToAction.cta')}
		image={need(callToAction.image, 'callToAction.image')}
	/>

	<Faq
		title={need(faq.heading, 'faq.heading')}
		items={(faq.questions ?? []).map((item, i) => ({
			question: need(item.question, 'FAQ question'),
			// Paragraphs are separated by blank lines in the Studio
			answer: need(item.answer, `"${item.question}" answer`).split(/\n\s*\n/).map((paragraph) => paragraph.trim()).filter(Boolean),
			open: i === 0,
		}))}
		footnotes={faq.footnotes ?? []}
	/>
</BaseLayout>
